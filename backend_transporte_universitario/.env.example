# Copia este archivo como .env y completa los valores

PORT=3000

# Base de datos
# Opción A: URL completa (Railway MySQL / MYSQL_URL) — prioridad sobre las variables individuales
DATABASE_URL=mysql://usuario:password@host:3306/nombre_base_datos
# Opción B: variables individuales
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nombre_base_datos
DB_USERNAME=usuario_bd
DB_PASSWORD=password_bd

# Seguridad
# Genera una clave fuerte con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_KEY=clave_firma_jwt
# Orígenes permitidos por CORS separados por coma (ej. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Datos del administrador inicial (se crean con: npm run seed)
ADMIN_CORREO=admin@universidad.edu
ADMIN_PASSWORD=password_admin_segura
ADMIN_IDENTIFICACION=0000000000
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=del Sistema
